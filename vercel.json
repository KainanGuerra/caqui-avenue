{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "NITRO_PRESET=static pnpm exec nuxt generate",
  "outputDirectory": ".output/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://caqui-kaki.onrender.com/api/:path*" },
    { "source": "/:path*", "destination": "/200.html" }
  ]
}
