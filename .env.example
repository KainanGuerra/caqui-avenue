# Pasta dos dados sintéticos (somente leitura). Padrão: ./data
DADOS_DIR=./data

# Redação das respostas: template (sem LLM, padrão), anthropic ou openai (compatível com OpenAI)
LLM_PROVIDER=template
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_MS=8000

# Entendimento com LLM (nível 2): só pode subir alerta, nunca remover sinal. Desligado por padrão.
UNDERSTANDING_LLM=false

# PIN do painel de suporte. Vazio: painel aberto, com aviso (só para uso local).
ATENDENTE_PIN=

# Relógio: dados (padrão: dia 18/11/2026 dos dados, hora real), real (data e hora reais) ou um ISO fixo, ex.: 2026-11-18T14:00-03:00
RELOGIO=dados

# Porta publicada no host pelo docker compose (padrão 3000)
PORT=3000

# Só no hot reload do docker compose: use true se o host não avisar sobre mudanças nos arquivos
CHOKIDAR_USEPOLLING=false
